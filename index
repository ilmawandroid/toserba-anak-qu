        </div>
      `;

      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('productModal').classList.add('hidden');
    }

    // CHECKOUT SIMULATION
    function checkout() {
      if (cart.length === 0) {
        alert('Keranjang Anda masih kosong. Silahkan pilih produk terlebih dahulu.');
        return;
      }
      alert('Terima kasih! Pesanan Anda di Toserba Anak QU berhasil dibuat. Tim kami akan segera memproses pesanan Anda.');
      cart = [];
      updateCartUI();
      toggleCart();
    }

    // INITIAL RENDER
    document.addEventListener('DOMContentLoaded', () => {
      renderProducts(products);
    });
  </script>
