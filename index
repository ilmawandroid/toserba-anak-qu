              <p class="text-[10px] text-brand-red font-bold">Rp ${p.price.toLocaleString('id-ID')}</p>
            </div>
            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded">${p.category}</span>
          </div>
        `).join('');
        dropdown.classList.remove('hidden');
      } else {
        dropdown.innerHTML = `<div class="p-4 text-xs text-slate-400 text-center">Tidak ada produk cocok dengan "${query}"</div>`;
        dropdown.classList.remove('hidden');
      }

      renderProducts(results);
    }

    // CART MANAGEMENT LOGIC
    function addToCart(productId) {
      const product = products.find(p => p.id === productId);
      const existing = cart.find(item => item.id === productId);

      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ ...product, qty: 1 });
      }

      updateCartUI();
      toggleCart(true); // Auto open cart
    }

    function updateQty(productId, change) {
      const item = cart.find(i => i.id === productId);
      if (item) {
        item.qty += change;
        if (item.qty <= 0) {
          cart = cart.filter(i => i.id !== productId);
        }
      }
      updateCartUI();
    }

    function updateCartUI() {
      const container = document.getElementById('cartItemsContainer');
      const countBadge = document.getElementById('cartCount');
      
      const totalQty = cart.reduce((acc, item) => acc + item.qty, 0);
      const subtotal = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);
      
      countBadge.innerText = totalQty;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 text-slate-400">
            <i class="fa-solid fa-basket-shopping text-5xl mb-3 text-slate-200"></i>
            <p class="font-bold text-sm text-slate-700">Keranjang Belanja Kosong</p>
            <p class="text-xs text-slate-400 mt-1">Yuk pilih mainan dan perlengkapan anak favoritmu!</p>
          </div>
        `;
      } else {
        container.innerHTML = cart.map(item => `
          <div class="py-3 flex items-center gap-3">
            <img src="${item.image}" class="w-14 h-14 object-cover rounded-xl border border-slate-100">
            <div class="flex-1">
              <h4 class="text-xs font-bold text-slate-800 line-clamp-1">${item.title}</h4>
              <p class="text-xs font-extrabold text-brand-red mt-0.5">Rp ${(item.price * item.qty).toLocaleString('id-ID')}</p>
              
              <div class="flex items-center gap-2 mt-2">
                <button onclick="updateQty(${item.id}, -1)" class="w-6 h-6 bg-slate-100 text-slate-600 rounded-md text-xs font-bold hover:bg-slate-200">-</button>
                <span class="text-xs font-bold">${item.qty}</span>
                <button onclick="updateQty(${item.id}, 1)" class="w-6 h-6 bg-slate-100 text-slate-600 rounded-md text-xs font-bold hover:bg-slate-200">+</button>
              </div>
            </div>
            <button onclick="updateQty(${item.id}, -${item.qty})" class="text-slate-300 hover:text-brand-red text-sm p-2">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        `).join('');
      }

      // Calculations
      document.getElementById('cartSubtotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
      
      // Free Shipping Calculator (min 300rb)
      const targetFreeShip = 300000;
      const progress = Math.min((subtotal / targetFreeShip) * 100, 100);
      document.getElementById('freeShipBar').style.width = `${progress}%`;

      if (subtotal >= targetFreeShip) {
        document.getElementById('freeShipText').innerHTML = `<span class="text-emerald-700 font-bold">🎉 Selamat! Anda mendapatkan GRATIS ONGKIR!</span>`;
        document.getElementById('cartOngkir').innerText = "GRATIS";
        document.getElementById('cartTotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
      } else {
        const sisa = targetFreeShip - subtotal;
        const ongkir = subtotal > 0 ? 20000 : 0;
        document.getElementById('freeShipText').innerText = `Belanja Rp ${sisa.toLocaleString('id-ID')} lagi untuk GRATIS ONGKIR!`;
        document.getElementById('cartOngkir').innerText = subtotal > 0 ? `Rp ${ongkir.toLocaleString('id-ID')}` : "Rp 0";
        document.getElementById('cartTotal').innerText = `Rp ${(subtotal + ongkir).toLocaleString('id-ID')}`;
      }
    }

    // TOGGLE CART DRAWER
    function toggleCart(openExplicitly = false) {
      const drawer = document.getElementById('cartDrawer');
      if (openExplicitly || drawer.classList.contains('pointer-events-none')) {
        drawer.classList.remove('pointer-events-none', 'opacity-0');
        drawer.classList.add('opacity-100');
      } else {
        drawer.classList.add('pointer-events-none', 'opacity-0');
        drawer.classList.remove('opacity-100');
      }
    }

